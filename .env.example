# Vivacada — one codebase, two run modes. Set APP_MODE to pick which one this
# process runs as. Everything below is grouped by which mode reads it; vars
# for the mode you're not running are simply ignored.

APP_MODE=testing
# APP_MODE=aggregator

PORT=3000
# Aggregator instances commonly use PORT=4000 instead, so a testing instance
# and an aggregator instance can run side by side during local development.


# ============================================================
# APP_MODE=testing — the self-hosted, human-proctored exam kiosk
# ============================================================

# Two distinct secrets. Do not reuse one for both.
UNLOCK_CODE=
PROCTOR_CODE=

# Issued to your institution by Vivacada after vetting.
INSTITUTION_API_KEY=
AGGREGATOR_ENDPOINT=https://aggregator.vivacada.example/api

# Your own compute. Provider: openai | claude | grok | gemini (OpenAI-compatible
# by default). Absent → mock interviewer/scorer (fine for testing the flow,
# not for real assessments).
LLM_PROVIDER=
LLM_MODEL=
LLM_ENDPOINT=
LLM_API_KEY=

# Dropdown fallback ONLY if the aggregator can't be reached at all — default
# subjects live on the aggregator's catalog, not here. Leave empty unless you
# want something to show during an aggregator outage. Levels are a fixed
# taxonomy baked into the grading engine, never configurable here.
SUBJECT_OPTIONS=

ALLOW_SPECIAL_CATALOG=true
QUESTIONS_PER_EXAM=20
SESSION_IDLE_TIMEOUT_MIN=15
CATALOG_CACHE_TTL_SEC=30


# ============================================================
# APP_MODE=aggregator — accounts, catalog, credentials, badges, employer matching
# ============================================================

# MongoDB (absent → local-file-persisted mock database at aggregator/data/db.json)
MONGODB_URI=
MONGODB_DB=vivacada_aggregator

# Seeds the first admin account on boot (needed to approve institutions and
# author the catalog). Leave unset and no admin is created.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional. A bearer token that grants the same access as an admin account,
# without needing to log in or hold a session cookie — for scripted/headless
# institution vetting and catalog authoring. Leave unset to disable.
ADMIN_API_KEY=

RATE_LIMIT_PER_DAY=500

# Comma-separated closed vocabulary for the single optional label an admin can
# assign to an institution (e.g. distinguishing an AI-proctored institution
# from an in-person one). Shown everywhere the institution's name appears.
# Absent → defaults to just "AI-Proctor".
INSTITUTION_LABELS=AI-Proctor

# Placeholder shared-secret auth for employer /api/briefs. Real employer
# accounts/billing are not yet designed.
EMPLOYER_API_KEY=


# ============================================================
# APP_MODE=ai-testing — the hosted, payment-gated, AI-proctored exam service
# ============================================================

# ROLE=client (default) runs the HTTP-facing app AND processes its own
# proctoring job queue. ROLE=worker runs ONLY the queue processor, no HTTP
# surface — for scaling out proctoring analysis across multiple instances
# behind one client-facing instance.
ROLE=client

# Required, no fallback. This app never persists to local disk, even in
# development — MOCK_MODE (below) substitutes fake payment/proctoring
# responses, but the data path (Mongo + S3) is always real.
MONGODB_URI=
MONGODB_DB=vivacada_ai_testing

# Required, no fallback, even in MOCK_MODE. Recording clips are deleted
# immediately after proctoring analysis, pass or fail — nothing is retained —
# but they still have to live somewhere real while an attempt is in flight,
# and any worker instance needs to be able to reach them.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Mocks payment AND proctoring verdicts (always approves, with a canned adult
# birthdate) so the flow can be tried without real payment or model credentials.
# Storage is never mocked — S3 above is always required. NOT the same as the
# other two apps' "runs with zero config" demo mode: there is no disk fallback
# here at all, mocked or not.
MOCK_MODE=false

# stripe | paypal — exactly one active provider. Both use a hosted-checkout
# redirect (Stripe Checkout / PayPal Orders), never embedded card fields.
# NOTE: implemented against each provider's documented API shape but not
# exercised against a real sandbox in this environment — test with real
# sandbox keys before taking any real payment.
PAYMENT_PROVIDER=stripe
STRIPE_API_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Cost in cents per attempt — first attempt and every retry, same price.
ATTEMPT_FEE_CENTS=1000

# The interview/grading model — same provider config shape as the kiosk,
# deliberately separate from the proctoring video model below so exam
# calibration never depends on which model is doing the proctoring.
LLM_PROVIDER=
LLM_MODEL=
LLM_ENDPOINT=
LLM_API_KEY=

# The proctoring video model — one general-purpose multimodal model handles
# face/ID matching, birthdate extraction, gesture/room-sweep review, and
# cheating signals, all in one call per attempt. NOTE: written against
# Claude's and OpenAI-compatible multimodal API shapes but not exercised
# against a real video-capable model in this environment — expect real
# prompt-tuning iteration before this is reliable.
VIDEO_MODEL_PROVIDER=
VIDEO_MODEL=
VIDEO_MODEL_ENDPOINT=
VIDEO_MODEL_API_KEY=

# How many times the analysis API call itself is retried on a technical
# failure (timeout, malformed response) before that single attempt at
# analysis is given up on — this is NOT the same as a rejection.
PROCTOR_MAX_RETRIES=3

# How many times a stuck/crashed job gets requeued (via the lease-timeout
# sweep or an exhausted PROCTOR_MAX_RETRIES) before the whole attempt is
# treated as failed and the user has to pay to retry.
PROCTOR_MAX_JOB_ATTEMPTS=2

# Minutes a claimed job can sit unfinished before a sweep assumes the worker
# died and puts it back in the queue for another worker to pick up.
PROCTOR_JOB_LEASE_MIN=10

# This app submits results to the aggregator exactly like a testing-app
# kiosk does — it's just another institution from the aggregator's
# perspective, typically vetted and labeled "AI-Proctor".
AGGREGATOR_ENDPOINT=https://aggregator.vivacada.example/api
INSTITUTION_API_KEY=

ALLOW_SPECIAL_CATALOG=true
QUESTIONS_PER_EXAM=20
PORT=3100
